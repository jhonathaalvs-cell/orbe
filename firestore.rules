rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if ownsUser(userId);
      allow list: if false;
      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'currency', 'timeZone', 'notificationPreferences'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && (!request.resource.data.keys().hasAny(['currency']) || request.resource.data.currency in ['BRL', 'USD', 'EUR'])
        && (!request.resource.data.keys().hasAny(['timeZone']) || request.resource.data.timeZone in [
          'America/Sao_Paulo', 'America/Manaus', 'America/Belem', 'America/Noronha', 'UTC'
        ])
        && (!request.resource.data.keys().hasAny(['notificationPreferences']) || (
          request.resource.data.notificationPreferences is map
          && request.resource.data.notificationPreferences.keys().hasOnly(['commitmentDue', 'commitmentOverdue'])
          && request.resource.data.notificationPreferences.keys().hasAll(['commitmentDue', 'commitmentOverdue'])
          && request.resource.data.notificationPreferences.commitmentDue is bool
          && request.resource.data.notificationPreferences.commitmentOverdue is bool
        ));
      allow delete: if false;

      match /transactions/{transactionId} {
        function validTransaction() {
          let data = request.resource.data;
          let hasCommitmentSource = data.keys().hasAny(['sourceCommitmentId', 'sourceOccurrenceId']);
          let hasCardSource = data.keys().hasAny(['sourceCardId', 'sourceInvoiceMonth']);
          let hasAccount = data.keys().hasAny(['accountId']);
          return data.keys().hasAll(['type', 'description', 'amount', 'category', 'date', 'createdAt'])
            && data.keys().hasOnly([
              'type', 'description', 'amount', 'category', 'date', 'createdAt',
              'sourceCommitmentId', 'sourceOccurrenceId', 'sourceCardId', 'sourceInvoiceMonth', 'accountId'
            ])
            && data.type in ['income', 'expense']
            && data.description is string
            && data.description.size() > 0
            && data.description.size() <= 50
            && data.category is string
            && data.category.size() > 0
            && data.category.size() <= 40
            && data.amount is number
            && data.amount > 0
            && data.amount <= 1000000000
            && data.date is string
            && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && data.createdAt == request.time
            && (!hasAccount || (data.accountId is string
              && get(/databases/$(database)/documents/users/$(userId)/accounts/$(data.accountId)).data.active == true))
            && (!hasCommitmentSource || (
              data.keys().hasAll(['sourceCommitmentId', 'sourceOccurrenceId'])
              && data.sourceCommitmentId is string
              && data.sourceOccurrenceId is string
              && getAfter(/databases/$(database)/documents/users/$(userId)/commitments/$(data.sourceCommitmentId)/occurrences/$(data.sourceOccurrenceId)).data.status == 'paid'
              && getAfter(/databases/$(database)/documents/users/$(userId)/commitments/$(data.sourceCommitmentId)/occurrences/$(data.sourceOccurrenceId)).data.transactionId == transactionId
            ))
            && (!hasCardSource || (
              !hasCommitmentSource
              && data.keys().hasAll(['sourceCardId', 'sourceInvoiceMonth'])
              && data.sourceCardId is string
              && data.sourceInvoiceMonth is string
              && getAfter(/databases/$(database)/documents/users/$(userId)/creditCards/$(data.sourceCardId)/invoices/$(data.sourceInvoiceMonth)).data.status == 'paid'
              && getAfter(/databases/$(database)/documents/users/$(userId)/creditCards/$(data.sourceCardId)/invoices/$(data.sourceInvoiceMonth)).data.transactionId == transactionId
              && getAfter(/databases/$(database)/documents/users/$(userId)/creditCards/$(data.sourceCardId)/invoices/$(data.sourceInvoiceMonth)).data.paidAmount == data.amount
              && getAfter(/databases/$(database)/documents/users/$(userId)/creditCards/$(data.sourceCardId)/invoices/$(data.sourceInvoiceMonth)).data.paidDate == data.date
            ));
        }

        allow get, list: if ownsUser(userId);
        allow create: if ownsUser(userId) && validTransaction();
        // Histórico financeiro não pode ser alterado ou removido pelo cliente.
        allow update, delete: if false;
      }

      match /accounts/{accountId} {
        function validAccount() {
          let data = request.resource.data;
          return data.keys().hasAll(['name', 'type', 'openingBalance', 'openingDate', 'active', 'createdAt'])
            && data.keys().hasOnly(['name', 'type', 'openingBalance', 'openingDate', 'active', 'createdAt'])
            && data.name is string && data.name.size() > 0 && data.name.size() <= 50
            && data.type in ['checking', 'savings', 'cash', 'investment', 'other']
            && data.openingBalance is number && data.openingBalance >= 0 && data.openingBalance <= 1000000000
            && data.openingDate is string && data.openingDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && data.active is bool && data.createdAt == request.time;
        }

        allow get, list: if ownsUser(userId);
        allow create: if ownsUser(userId) && validAccount();
        allow update: if ownsUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'active'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 50
          && request.resource.data.active is bool;
        allow delete: if false;
      }

      match /transfers/{transferId} {
        function validTransfer() {
          let data = request.resource.data;
          return data.keys().hasAll(['fromAccountId', 'toAccountId', 'amount', 'description', 'date', 'createdAt'])
            && data.keys().hasOnly(['fromAccountId', 'toAccountId', 'amount', 'description', 'date', 'createdAt'])
            && data.fromAccountId is string && data.toAccountId is string
            && data.fromAccountId != data.toAccountId
            && get(/databases/$(database)/documents/users/$(userId)/accounts/$(data.fromAccountId)).data.active == true
            && get(/databases/$(database)/documents/users/$(userId)/accounts/$(data.toAccountId)).data.active == true
            && data.amount is number && data.amount > 0 && data.amount <= 1000000000
            && data.description is string && data.description.size() > 0 && data.description.size() <= 80
            && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && data.createdAt == request.time;
        }

        allow get, list: if ownsUser(userId);
        allow create: if ownsUser(userId) && validTransfer();
        allow update, delete: if false;
      }

      match /commitments/{commitmentId} {
        function validCommitment() {
          let data = request.resource.data;
          return data.keys().hasAll(['name', 'amount', 'category', 'frequency', 'startDate', 'endDate', 'active', 'createdAt'])
            && data.keys().hasOnly(['name', 'amount', 'category', 'frequency', 'startDate', 'endDate', 'active', 'createdAt'])
            && data.name is string
            && data.name.size() > 0
            && data.name.size() <= 80
            && data.amount is number
            && data.amount > 0
            && data.amount <= 1000000000
            && data.category is string
            && data.category.size() > 0
            && data.category.size() <= 40
            && data.frequency in ['once', 'daily', 'weekly', 'monthly', 'yearly']
            && data.startDate is string
            && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && (data.endDate == null || (data.endDate is string && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$') && data.endDate >= data.startDate))
            && data.active is bool
            && data.createdAt == request.time;
        }

        allow get, list: if ownsUser(userId);
        allow create: if ownsUser(userId) && validCommitment()
          && getAfter(/databases/$(database)/documents/users/$(userId)/commitments/$(commitmentId)/occurrences/$(request.resource.data.startDate)).data.commitmentId == commitmentId;
        allow update: if ownsUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'name', 'amount', 'category'])
          && request.resource.data.active is bool
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000000000
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.category.size() <= 40;
        allow delete: if false;

        match /occurrences/{occurrenceId} {
          allow get, list: if ownsUser(userId);
          // Cliente pode criar somente o primeiro vencimento, junto com o compromisso.
          allow create: if ownsUser(userId)
            && occurrenceId == getAfter(/databases/$(database)/documents/users/$(userId)/commitments/$(commitmentId)).data.startDate
            && request.resource.data.keys().hasOnly(['commitmentId', 'name', 'category', 'amount', 'dueDate', 'status', 'createdAt'])
            && request.resource.data.commitmentId == commitmentId
            && request.resource.data.name == getAfter(/databases/$(database)/documents/users/$(userId)/commitments/$(commitmentId)).data.name
            && request.resource.data.category == getAfter(/databases/$(database)/documents/users/$(userId)/commitments/$(commitmentId)).data.category
            && request.resource.data.amount == getAfter(/databases/$(database)/documents/users/$(userId)/commitments/$(commitmentId)).data.amount
            && request.resource.data.dueDate == occurrenceId
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time;
          // Marcar pago e criar a despesa devem ocorrer atomicamente na mesma transação.
          allow update: if ownsUser(userId)
            && resource.data.status == 'pending'
            && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paidDate', 'transactionId', 'paidAmount'])
                && request.resource.data.status == 'paid'
                && request.resource.data.paidAt == request.time
                && request.resource.data.paidDate is string
                && request.resource.data.paidDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
                && request.resource.data.transactionId is string
                && request.resource.data.paidAmount is number
                && request.resource.data.paidAmount > 0
                && request.resource.data.paidAmount <= 1000000000
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.sourceCommitmentId == commitmentId
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.sourceOccurrenceId == occurrenceId
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.type == 'expense'
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.description == resource.data.name
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.category == resource.data.category
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.amount == request.resource.data.paidAmount
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.date == request.resource.data.paidDate)
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'skippedAt'])
                && request.resource.data.status == 'skipped'
                && request.resource.data.skippedAt == request.time)
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'amount'])
                && request.resource.data.status == 'pending'
                && request.resource.data.name is string
                && request.resource.data.name.size() > 0
                && request.resource.data.name.size() <= 80
                && request.resource.data.category is string
                && request.resource.data.category.size() > 0
                && request.resource.data.category.size() <= 40
                && request.resource.data.amount is number
                && request.resource.data.amount > 0
                && request.resource.data.amount <= 1000000000
                && request.resource.data.name == getAfter(/databases/$(database)/documents/users/$(userId)/commitments/$(commitmentId)).data.name
                && request.resource.data.category == getAfter(/databases/$(database)/documents/users/$(userId)/commitments/$(commitmentId)).data.category
                && request.resource.data.amount == getAfter(/databases/$(database)/documents/users/$(userId)/commitments/$(commitmentId)).data.amount)
            );
          allow delete: if false;
        }
      }

      match /notifications/{notificationId} {
        allow get, list: if ownsUser(userId);
        allow update: if ownsUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }

      match /goals/{goalId} {
        function validGoal(data) {
          return data.keys().hasAll(['name', 'targetAmount', 'monthlyContribution', 'targetDate', 'createdDate', 'targetHistory', 'active', 'createdAt', 'updatedAt'])
            && data.keys().hasOnly(['name', 'targetAmount', 'monthlyContribution', 'targetDate', 'createdDate', 'targetHistory', 'active', 'createdAt', 'updatedAt', 'updatedDate'])
            && data.name is string && data.name.size() > 0 && data.name.size() <= 80
            && data.targetAmount is number && data.targetAmount > 0 && data.targetAmount <= 1000000000
            && (data.monthlyContribution == null || (data.monthlyContribution is number && data.monthlyContribution > 0 && data.monthlyContribution <= 1000000000))
            && (data.targetDate == null || (data.targetDate is string && data.targetDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))
            && data.createdDate is string && data.createdDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && data.targetHistory is list && data.targetHistory.size() > 0 && data.targetHistory.size() <= 100
            && data.active is bool;
        }
        allow get, list: if ownsUser(userId);
        allow create: if ownsUser(userId) && validGoal(request.resource.data)
          && request.resource.data.active == true
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'targetAmount', 'monthlyContribution', 'targetDate', 'targetHistory', 'updatedDate', 'updatedAt'])
          && validGoal(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdDate == resource.data.createdDate
          && request.resource.data.active == resource.data.active
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsUser(userId);

        match /deposits/{depositId} {
          allow get, list: if ownsUser(userId)
            && exists(/databases/$(database)/documents/users/$(userId)/goals/$(goalId));
          allow create: if ownsUser(userId)
            && exists(/databases/$(database)/documents/users/$(userId)/goals/$(goalId))
            && request.resource.data.keys().hasAll(['amount', 'date', 'createdAt'])
            && request.resource.data.keys().hasOnly(['amount', 'date', 'note', 'createdAt'])
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.amount <= 1000000000
            && request.resource.data.date is string
            && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && (!request.resource.data.keys().hasAny(['note']) || (request.resource.data.note is string && request.resource.data.note.size() <= 120))
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if ownsUser(userId)
            && exists(/databases/$(database)/documents/users/$(userId)/goals/$(goalId));
        }
      }

      match /creditCards/{cardId} {
        function validCard(data) {
          return data.keys().hasAll(['name', 'brand', 'lastFour', 'creditLimit', 'closingDay', 'dueDay', 'active', 'createdAt', 'updatedAt'])
            && data.keys().hasOnly(['name', 'brand', 'lastFour', 'creditLimit', 'closingDay', 'dueDay', 'active', 'createdAt', 'updatedAt'])
            && data.name is string && data.name.size() > 0 && data.name.size() <= 50
            && data.brand in ['visa', 'mastercard', 'elo', 'amex', 'other']
            && data.lastFour is string && (data.lastFour == '' || data.lastFour.matches('^\\d{4}$'))
            && data.creditLimit is number && data.creditLimit > 0 && data.creditLimit <= 1000000000
            && data.closingDay is int && data.closingDay >= 1 && data.closingDay <= 28
            && data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 28
            && data.active is bool;
        }
        allow get, list: if ownsUser(userId);
        allow create: if ownsUser(userId)
          && validCard(request.resource.data)
          && request.resource.data.active == true
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'brand', 'lastFour', 'creditLimit', 'closingDay', 'dueDay', 'active', 'updatedAt'])
          && validCard(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;

        match /purchases/{purchaseId} {
          allow get, list: if ownsUser(userId);
          allow create: if ownsUser(userId)
            && get(/databases/$(database)/documents/users/$(userId)/creditCards/$(cardId)).data.active == true
            && request.resource.data.keys().hasAll(['cardId', 'description', 'category', 'amount', 'date', 'invoiceMonth', 'dueDate', 'createdAt'])
            && request.resource.data.keys().hasOnly(['cardId', 'description', 'category', 'amount', 'date', 'invoiceMonth', 'dueDate', 'createdAt', 'installmentNumber', 'installmentCount'])
            && request.resource.data.cardId == cardId
            && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 80
            && request.resource.data.category is string && request.resource.data.category.size() > 0 && request.resource.data.category.size() <= 40
            && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000
            && request.resource.data.date is string && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && request.resource.data.invoiceMonth is string && request.resource.data.invoiceMonth.matches('^\\d{4}-\\d{2}$')
            && request.resource.data.dueDate is string && request.resource.data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && ((!('installmentNumber' in request.resource.data) && !('installmentCount' in request.resource.data))
              || (request.resource.data.installmentNumber is int && request.resource.data.installmentNumber >= 1
                && request.resource.data.installmentCount is int && request.resource.data.installmentCount >= 2 && request.resource.data.installmentCount <= 10
                && request.resource.data.installmentNumber <= request.resource.data.installmentCount))
            && request.resource.data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/users/$(userId)/creditCards/$(cardId)/invoices/$(request.resource.data.invoiceMonth)).data.status == 'open'
            && getAfter(/databases/$(database)/documents/users/$(userId)/creditCards/$(cardId)/invoices/$(request.resource.data.invoiceMonth)).data.lastPurchaseId == purchaseId
            && getAfter(/databases/$(database)/documents/users/$(userId)/creditCards/$(cardId)/invoices/$(request.resource.data.invoiceMonth)).data.lastPurchaseAmount == request.resource.data.amount;
          allow update, delete: if false;
        }

        match /invoices/{invoiceMonth} {
          function validInvoice(data) {
            return data.keys().hasAll(['cardId', 'invoiceMonth', 'dueDate', 'total', 'purchaseCount', 'status', 'lastPurchaseId', 'lastPurchaseAmount', 'createdAt', 'updatedAt'])
              && data.keys().hasOnly(['cardId', 'invoiceMonth', 'dueDate', 'total', 'purchaseCount', 'status', 'lastPurchaseId', 'lastPurchaseAmount', 'createdAt', 'updatedAt', 'paidAt', 'paidDate', 'paidAmount', 'transactionId'])
              && data.cardId == cardId
              && data.invoiceMonth == invoiceMonth
              && data.dueDate is string && data.dueDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
              && data.total is number && data.total > 0 && data.total <= 1000000000
              && data.purchaseCount is int && data.purchaseCount > 0
              && data.status in ['open', 'paid']
              && data.lastPurchaseId is string
              && data.lastPurchaseAmount is number && data.lastPurchaseAmount > 0
              && data.createdAt is timestamp && data.updatedAt == request.time;
          }
          allow get, list: if ownsUser(userId);
          allow create: if ownsUser(userId)
            && validInvoice(request.resource.data)
            && request.resource.data.status == 'open'
            && request.resource.data.purchaseCount == 1
            && request.resource.data.total == request.resource.data.lastPurchaseAmount
            && request.resource.data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/users/$(userId)/creditCards/$(cardId)/purchases/$(request.resource.data.lastPurchaseId)).data.invoiceMonth == invoiceMonth;
          allow update: if ownsUser(userId)
            && validInvoice(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt
            && (
              (resource.data.status == 'open'
                && request.resource.data.status == 'open'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dueDate', 'total', 'purchaseCount', 'lastPurchaseId', 'lastPurchaseAmount', 'updatedAt'])
                && request.resource.data.total == resource.data.total + request.resource.data.lastPurchaseAmount
                && request.resource.data.purchaseCount == resource.data.purchaseCount + 1
                && getAfter(/databases/$(database)/documents/users/$(userId)/creditCards/$(cardId)/purchases/$(request.resource.data.lastPurchaseId)).data.invoiceMonth == invoiceMonth)
              || (resource.data.status == 'open'
                && request.resource.data.status == 'paid'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paidDate', 'paidAmount', 'transactionId', 'updatedAt'])
                && request.resource.data.paidAt == request.time
                && request.resource.data.paidDate is string && request.resource.data.paidDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
                && request.resource.data.paidAmount == resource.data.total
                && request.resource.data.transactionId is string
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.sourceCardId == cardId
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.sourceInvoiceMonth == invoiceMonth
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.type == 'expense'
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.amount == request.resource.data.paidAmount
                && getAfter(/databases/$(database)/documents/users/$(userId)/transactions/$(request.resource.data.transactionId)).data.date == request.resource.data.paidDate)
            );
          allow delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
